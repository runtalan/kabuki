{
  "apphosting": {
    "backendId": "kabuki",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "env": [
      "DATABASE_URL",
      "AUTH_SECRET",
      "PLAID_CLIENT_ID",
      "PLAID_SECRET",
      "PLAID_ENV",
      "AUTH_URL",
      "AUTH_TRUST_HOST",
      "AUTH_GOOGLE_ID",
      "AUTH_GOOGLE_SECRET",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "alwaysDeployFromSource": false
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
